<% if (theme.posts_overview.post_count == 0) { %>
<!-- Home page with custom hero and highlights -->
<div id="hero-section">
  <div class="hero-content">
    <h1>Building solutions to complex problems</h1>
    <p class="tagline">VP Product at Prove | 20+ years in tech | NYC-based</p>
    <div class="cta-buttons">
      <a href="/career/" class="btn btn-primary">View Career</a>
      <a href="/about/" class="btn btn-secondary">Read My Story</a>
    </div>
  </div>
</div>

<div id="highlights-section">
  <h2>Key Highlights</h2>
  <div class="highlights-grid">
    <div class="highlight-card">
      <div class="icon">🚀</div>
      <h3>20+ Years</h3>
      <p>Building and scaling products in fintech, identity, and digital services</p>
    </div>
    <div class="highlight-card">
      <div class="icon">💼</div>
      <h3>7 Companies</h3>
      <p>From bootstrapped startups to scaled enterprises across multiple industries</p>
    </div>
    <div class="highlight-card">
      <div class="icon">🛠️</div>
      <h3>Full Stack</h3>
      <p>Backend architecture, frontend, DevOps, and product leadership</p>
    </div>
    <div class="highlight-card">
      <div class="icon">🌍</div>
      <h3>Global Impact</h3>
      <p>Identity verification, payments, and compliance solutions for millions</p>
    </div>
  </div>
</div>

<div id="featured-roles-section">
  <h2>Featured Roles</h2>
  <div class="featured-roles">
    <div class="role-card">
      <h3>Prove</h3>
      <p class="role-title">VP, Product</p>
      <p class="role-dates">September 2018 - Present</p>
      <p>Spearheading growth initiatives and product development in the digital identity space, scaling revenue from $20M to $150M+</p>
      <a href="/2025/04/29/Prove/">Read more →</a>
    </div>
    <div class="role-card">
      <h3>ElimiWait Parking</h3>
      <p class="role-title">Director of Engineering</p>
      <p class="role-dates">October 2016 - September 2018</p>
      <p>Led engineering for mobile parking solutions, implementing advanced yield management and real-time payment processing</p>
      <a href="/2025/04/29/ElimiWait-Parking/">Read more →</a>
    </div>
    <div class="role-card">
      <h3>Cognia</h3>
      <p class="role-title">VP, Engineering</p>
      <p class="role-dates">January 2012 - May 2015</p>
      <p>Built regulated financial infrastructure for call center payments, managing PCI-DSS compliance at scale</p>
      <a href="/2025/04/29/Cognia/">Read more →</a>
    </div>
  </div>
</div>

<div id="skills-section">
  <h2>Technologies & Skills</h2>
  <div class="skills-grid">
    <div class="skill-category">
      <h4>Languages</h4>
      <div class="skill-tags">
        <span>Python</span>
        <span>JavaScript</span>
        <span>Java</span>
        <span>Go</span>
        <span>SQL</span>
      </div>
    </div>
    <div class="skill-category">
      <h4>Platforms</h4>
      <div class="skill-tags">
        <span>AWS</span>
        <span>Kubernetes</span>
        <span>Docker</span>
        <span>PostgreSQL</span>
        <span>Redis</span>
      </div>
    </div>
    <div class="skill-category">
      <h4>Domains</h4>
      <div class="skill-tags">
        <span>Identity Verification</span>
        <span>Payments</span>
        <span>Compliance</span>
        <span>RegTech</span>
        <span>Product Leadership</span>
      </div>
    </div>
  </div>
</div>

<div id="cta-section">
  <h2>Let's Connect</h2>
  <p>Interested in collaborating or learning more? I'm always open to discussing new challenges and opportunities.</p>
  <a href="mailto:oliver@snell.me" class="btn btn-large">Get in Touch</a>
</div>

<% } else { %>
<!-- Default index page with about section -->
<section id="about" class="p-note">
  <% if (config.description) { %>
    <%- markdown(config.description) %>
  <% } %>
  <% if (theme.social_links) { %>
    <p>
      <%= __('index.find_me_on') %>
      <% var nb_links = theme.social_links.length %>
      <% var i = 0 %>
      <% for(var {label, icon, link} of theme.social_links) { %>
        <% var title = label || icon %>
        <% if (icon == 'mail') { %>
          <a class="icon u-email" target="_blank" rel="noopener" href="<%- link %>" aria-label="<%- title %>" title="<%- title %>">
            <i class="fa-solid fa-envelope"></i><!--
      ---></a>
        <% } else if (icon == 'rss') { %>
          <a class="icon" target="_blank" rel="noopener" href="<%- link %>" aria-label="<%- title %>" title="<%- title %>">
            <i class="fa-solid fa-rss"></i>
          </a>
        <% } else { %>
          <a class="icon u-url" target="_blank" rel="noopener me" href="<%- url_for(link) %>" aria-label="<%- title %>" title="<%- title %>">
            <i class="fa-brands fa-<%= icon %>"></i><!--
      ---></a><!--
    ---><% } %><!--
    ---><%= ( nb_links > 0 && i < nb_links-1 ?
            ( i == nb_links-2 ? ' '+__('index.enum_and')+' '
            : __('index.enum_comma')+' ' )
            : '.' ) %>
        <% i+=1 %>
      <% } %>
    </p>
  <% } %>
</section>
<% } %>

<% if (theme.posts_overview.post_count > 0 || theme.posts_overview.show_all_posts) { %>
<section id="writing">
  <span class="h1"><a href="<%- url_for(theme.nav.articles) %>"><%= __('index.articles') %></a></span>
  <% if (theme.tags_overview && site.tags.length) { %>
  <span class="h2"><%= __('index.topics') %></span>
  <span class="widget tagcloud">
    <%- tagcloud(theme.tags_overview) %>
  </span>
  <span class="h2"><%= __('index.most_recent') %></span>
  <% } %>
  <ul class="post-list">
    <% var field_sort = theme.posts_overview.sort_updated ? 'updated' : 'date' %>
    <% if (theme.posts_overview.show_all_posts) { %>
      <% var show_posts = page.posts.filter((p) => !p.job_title).sort(field_sort, 'desc') %>
    <% } else { %>
      <% var show_posts = site.posts.filter((p) => !p.job_title).sort(field_sort, 'desc').limit(theme.posts_overview.post_count || 5) %>
    <% } %>
    <% show_posts.each(function(post, i){ %>
      <li class="post-item">
        <%- partial('_partial/post/date', { post: post, class_name: 'meta' }) %>
        <span><%- partial('_partial/post/title', { post: post, index: true, class_name: '' }) %></span>
      </li>
    <% }); %>
  </ul>
  <% if (theme.posts_overview.show_all_posts) { %>
    <%- partial('_partial/pagination') %>
  <% } %>
</section>
<% } %>

<% if (site.data.projects) { %>
<section id="projects">
  <span class="h1"><a href="<%- url_for(theme.projects_url) %>"><%= __('index.projects') %></a></span>
  <ul class="project-list">
    <% for(var obj in site.data.projects){ %>
      <li class="project-item">
        <a href="<%= site.data.projects[obj].url %>"><%= site.data.projects[obj].name %></a>: <%- markdown(site.data.projects[obj].desc) %>
      </li>
    <% } %>
  </ul>
</section>
<% } %>

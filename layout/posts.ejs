<h1>Posts</h1>
<div id="archive">
  <ul class="post-list">
    <% site.posts.filter((p) => p.layout === 'post').sort('date', 'desc').each(function(post) { %>
      <li class="post-item">
        <%- partial('_partial/post/date', { post: post, class_name: 'meta' }) %>
        <span><%- partial('_partial/post/title', { post: post, index: true, class_name: '' }) %></span>
      </li>
    <% }); %>
  </ul>
</div>

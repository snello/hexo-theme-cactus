<div>
    <h3>
        <a class="<%= class_name %>" href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h3>
    <% if(post.description) { %>
        <p><%= post.description %></p>
    <% } %>
    <div class="project-quick-links">
        <% if(post.repository) { %>
            <a href="<%= post.repository %>" target="_blank">Repository</a> |
        <% } %>
        <% if(post.live_url) { %>
            <a href="<%= post.live_url %>" target="_blank">Live Version</a>
        <% } %>
    </div>
</div>
<%- partial('_partial/post/tag', {page: post}) %>
